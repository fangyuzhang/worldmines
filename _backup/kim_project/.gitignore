# Godot 4 缓存目录
.godot/

# 导出产物与凭据
export.cfg
export_credentials.cfg

# 系统文件
.DS_Store
Thumbs.db
*.tmp

# Python 缓存
__pycache__/
*.pyc

# 临时调试脚本
**/test/debug_*.gd

# AI-assisted commit: ignore IDE data / build output / archives
.codebuddy/
builds/
*.zip

# Godot 编辑器加载 GDExtension 时生成的临时锁文件（如 ~godot-wasm.dll）
~*.dll
