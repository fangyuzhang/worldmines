; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="世界扫雷"
config/version="1.0.0"
run/main_scene="res://ui/level_select.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

RNGService="*res://core/rng_service.gd"
ModAPI="*res://core/mod_api.gd"
DebugMenu="*res://addons/debug_menu/debug_menu.tscn"
SettingsManager="*res://ui/settings_manager.gd"
ThemeManager="*res://ui/theme_manager.gd"
GameSession="*res://ui/game_session.gd"
AudioManager="*res://ui/audio_manager.gd"
SkinService="*res://ui/skin_service.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[debug]

gdscript/warnings/shadowed_global_identifier=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="世界扫雷"

[editor_plugins]

enabled=PackedStringArray("res://addons/debug_menu/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/gut/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/WenYuanRoundedSCVF-subset.ttf"

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_2d=2
