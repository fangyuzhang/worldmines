; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="世界扫雷 (Copy)"
config/version="1.0.0"
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

RNGService="*res://core/rng_service.gd"
ModAPI="*res://core/mod_api.gd"
DebugMenu="*uid://cggqb75a8w8r"
SettingsManager="*res://ui/settings_manager.gd"
ThemeManager="*res://ui/theme_manager.gd"
GameSession="*res://ui/game_session.gd"
AudioManager="*res://ui/audio_manager.gd"
SkinService="*res://ui/skin_service.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[debug]

; 2026-09-18 分析器告警治理（调试器清零）——以下两类为「领域命名的噪音」，工程级关闭：
; integer_division：棋盘几何全部为有意整数运算（约 30 处，逐处 @warning_ignore 是纯噪音）；
; shadowed_global_identifier：seed/sign/is_inf/wrap 等领域词恰与内建函数同名（约 28 处），无缺陷价值；
; 其余遮蔽 / 未用参数类告警保持默认并逐个真修（同名参数改 _ 前缀或换名）。
gdscript/warnings/integer_division=0
gdscript/warnings/shadowed_global_identifier=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="世界扫雷 (Copy)"

[editor_plugins]

enabled=PackedStringArray("res://addons/debug_menu/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/gut/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
