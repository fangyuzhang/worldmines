# Godot 4+ specific ignores
.godot/
/android/

# 工具/IDE 缓存（不参与构建，勿提交）
.codebuddy/
.gdmcp/
.logs/
addons/.godot_ai_update/

# 交付包与临时压缩包（体积大、可再生）
*.zip

# 插件更新失败残留（形如 ~godot-wasm.dll~RF1f1b32.TMP / ~godot-wasm.dll，单个 11MB）
~*.TMP
*.TMP
~*

# 临时诊断脚本（下划线开头，勿提交；tools/ 下同样适用）
/_*.ps1
/_*.gd
/_*.gd.uid
/_*.py
/_*.sh
/_staged_levels/
__pycache__/
/tools/_*.gd
/tools/_*.gd.uid
/tools/_*.ps1
/tools/_*.py
/tools/_*.sh
/tools/_*.txt

# 批量生成运行日志目录（_probe_logs/_batch_logs/_fill*_logs 等）
/_*_logs/

# ⚠️ 备份目录绝不能放在工程目录内：其中的 .gd 副本会带着同样的 class_name
# 参与全局类扫描，导致「磁盘上是新代码、运行却是旧行为」（见坑表 #28）。
# 备份一律放到工程外的 %TEMP%。
/_backup_*/
/tools/_*.bat
